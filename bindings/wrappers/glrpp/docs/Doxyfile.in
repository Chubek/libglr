DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "libglr C++ Bindings"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Header-only C++ wrapper for libglr"
OUTPUT_DIRECTORY       = "@GLRPP_DOCS_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
INLINE_INHERITED_MEMB  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES
INHERIT_DOCS           = YES

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@GLRPP_PROJECT_SOURCE_DIR@"    	\
                         "@GLRPP_DOCS_SOURCE_DIR@"`		\
STRIP_FROM_INC_PATH    = "@GLRPP_PROJECT_SOURCE_DIR@/include"
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = "@GLRPP_DOCS_SOURCE_DIR@/mainpage.md"

INPUT                  = "@GLRPP_PROJECT_SOURCE_DIR@/include/glrpp" \
                         "@GLRPP_DOCS_SOURCE_DIR@/mainpage.md"
@GLRPP_BOOKLET_INPUT@
FILE_PATTERNS          = *.hpp \
                         *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       =
IMAGE_PATH             = "@GLRPP_DOCS_SOURCE_DIR@"

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_BY_SCOPE_NAME     = YES
SORT_GROUP_NAMES       = YES
ALPHABETICAL_INDEX     = YES
ENUM_VALUES_PER_LINE   = 1

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 120
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
LATEX_BATCHMODE        = NO
LATEX_HIDE_INDICES     = NO
LATEX_CMD_NAME         = xelatex
MAKEINDEX_CMD_NAME     = makeindex
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
LATEX_HEADER           = "@GLRPP_DOCS_SOURCE_DIR@/ltx-header.tex"
LATEX_FOOTER           = "@GLRPP_DOCS_SOURCE_DIR@/ltx-footer.tex"

GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = YES
