#---------------------------------------------------------------------------
# Project related configuration
#---------------------------------------------------------------------------

PROJECT_NAME           = "glrpp"
PROJECT_BRIEF          = "Header-only C++20 DSL wrapper for libglr"
PROJECT_NUMBER         = @PACKAGE_VERSION@
OUTPUT_DIRECTORY       = @CMAKE_BINARY_DIR@/docs
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Build configuration
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INTERNAL_DOCS          = YES

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

INPUT                  = @CMAKE_SOURCE_DIR@/include \
                         @CMAKE_SOURCE_DIR@/README.md \
                         @CMAKE_SOURCE_DIR@/GUIDE.md \
                         @CMAKE_SOURCE_DIR@/docs/mainpage.md

FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

#---------------------------------------------------------------------------
# C++ parsing
#---------------------------------------------------------------------------

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO

BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO

CLANG_ASSISTED_PARSING = YES
CLANG_OPTIONS          = -std=c++20

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

#---------------------------------------------------------------------------
# Template-heavy code handling
#---------------------------------------------------------------------------

TYPEDEF_HIDES_STRUCT   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

# Improves template readability
TEMPLATE_RELATIONS     = YES

#---------------------------------------------------------------------------
# Graphs & Diagrams
#---------------------------------------------------------------------------

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 20

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES

HTML_EXTRA_STYLESHEET  = docs/assets/doxygen-awesome.css

#---------------------------------------------------------------------------
# LaTeX (optional)
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = NO

#---------------------------------------------------------------------------
# Layout customization
#---------------------------------------------------------------------------

LAYOUT_FILE            = docs/layout.xml
