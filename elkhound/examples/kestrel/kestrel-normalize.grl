; Normalise a desugared grammar so the GLR parser forks less often.
; Order matters:
;   1. epsilon elimination exposes new unit productions,
;   2. unit-production removal can orphan symbols,
;   3. useless-symbol cleanup runs before factoring so we don't
;      factor dead alternatives,
;   4. left-factor merges shared prefixes (Param, Variant, Paren, ...).
(rewrite
  (name "kestrel-normalize")
  (rules
    (eliminate-epsilon-production)
    (remove-unit-productions)
    (eliminate-useless-symbols)
    (left-factor)))
