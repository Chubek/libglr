PROJECT_NAME           = "libglr"
PROJECT_BRIEF          = "Generalized LR parsing library for C"
PROJECT_NUMBER         = "1.0.0"
OUTPUT_DIRECTORY       = build
INPUT                  = ../include/glr . ../disambstd ../rewritelib
EXCLUDE                = build ./build
EXCLUDE_PATTERNS       = */build/*
FILE_PATTERNS          = *.h *.md *.dox *.grl
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = mainpage.md
EXTENSION_MAPPING      = grl=Python
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
TYPEDEF_HIDES_STRUCT   = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_HEADER            = header.html
HTML_FOOTER            = footer.html
HTML_STYLESHEET        =
HTML_EXTRA_STYLESHEET  = stylesheet.css
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
LATEX_HEADER           = header.tex
LATEX_FOOTER           = footer.tex
GENERATE_MAN           = YES
MAN_OUTPUT             = man
MAN_EXTENSION          = .3
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
HAVE_DOT               = NO
QUIET                  = NO
WARN_AS_ERROR          = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = doxygen_warnings.log
